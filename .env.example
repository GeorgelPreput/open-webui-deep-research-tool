# Copy to .env and edit, then: docker compose up --build
#
# Open WebUI session/cookie signing key — any random string.
WEBUI_SECRET_KEY=please-change-me

# Shared secret between Open WebUI and the Pipelines sidecar. Keep the default
# unless you also change it in the OWUI Pipelines connection settings.
PIPELINES_API_KEY=0p3n-w3bu!

# Admin API key the OpenAPI / MCP / Pipelines services use to call BACK into
# Open WebUI (for LLM, embeddings, web search, KB). Generate it after the first
# login:  OWUI > Settings > Account > API Keys.  Leave blank on first boot, then
# fill it in and run `docker compose up -d` again to restart the callers.
DR_OWUI_API_KEY=
